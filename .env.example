# Mobile-safe public Supabase values (never put service-role credentials in EXPO_PUBLIC_* variables)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Backend-only values. Copy this file to an ignored .env before local use.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
REDPANDA_BROKERS=redpanda:9092
FORCE_COMMAND_FAILURE=false
AGROPULSE_TEST_USER_PASSWORD=replace-with-local-test-password
