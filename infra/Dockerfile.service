FROM node:22-alpine AS build

ARG SERVICE_DIRECTORY
ARG SERVICE_WORKSPACE

WORKDIR /workspace

# npm ci remains authoritative: all installs are resolved from the committed root lockfile.
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/contracts/package.json ./packages/contracts/package.json
COPY services/worker/package.json ./services/worker/package.json
COPY services/simulator/package.json ./services/simulator/package.json
COPY services/command-publisher/package.json ./services/command-publisher/package.json

RUN npm ci --workspace @agropulse/contracts --workspace ${SERVICE_WORKSPACE} \
    --include-workspace-root=false --ignore-scripts --no-audit --no-fund

COPY packages/contracts ./packages/contracts
COPY services/${SERVICE_DIRECTORY} ./services/${SERVICE_DIRECTORY}

RUN npm run build --workspace @agropulse/contracts \
    && npm run build:service --workspace ${SERVICE_WORKSPACE}

FROM node:22-alpine

ARG SERVICE_DIRECTORY
ENV SERVICE_DIRECTORY=${SERVICE_DIRECTORY}

WORKDIR /workspace
COPY --from=build /workspace/node_modules ./node_modules
COPY --from=build /workspace/packages/contracts/package.json ./packages/contracts/package.json
COPY --from=build /workspace/packages/contracts/dist ./packages/contracts/dist
COPY --from=build /workspace/services/${SERVICE_DIRECTORY}/package.json ./services/${SERVICE_DIRECTORY}/package.json
COPY --from=build /workspace/services/${SERVICE_DIRECTORY}/dist ./services/${SERVICE_DIRECTORY}/dist

CMD ["sh", "-c", "node services/${SERVICE_DIRECTORY}/dist/index.js"]
